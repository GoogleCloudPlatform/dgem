{{- $tok := default "St." .target_token -}}
{
  "schema": {
    "instructions": "Determine the correct forward text normalization (spoken expansion) for the ambiguous token in the provided context. Output a JSON object with the key \"expansion\" set to the exact selected option name.",
    "questions": [
      {
        "id": "expansion",
        "type": "choice",
        "instructions": {{ printf "Select the exact spoken verbalization for target token '%s'" $tok | toJson }},
        "options": [
          {{- if .options }}
          {{ range $i, $opt := .options }}
          {{ if $i }},{{ end }}{"name": {{ $opt | toJson }}}
          {{ end }}
          {{- else }}
          {"name": "Saint"},
          {"name": "Street"}
          {{- end }}
        ]
      }
    ],
    "samples": {{ default 1 .samples | toJson }}
  },
  "state": {
    "sentence": {{ default "Meet me outside St. Patrick Cathedral at noon." .input | toJson }},
    "target_token": {{ $tok | toJson }}
  }
}
