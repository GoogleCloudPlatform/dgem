{
  "schema": {
    "instructions": "High-entropy tie-breaker: Multiple candidate intents had competing probability mass on the first pass. Carefully compare the exact wording of the user utterance against ONLY these finalist intents (pay close attention to specific nouns/verbs: e.g., cash withdrawal vs. card payment, unrecognised transaction vs. stolen/compromised card, beneficiary not allowed vs. general failed transfer, pending vs. failed top-up, general maintenance appointment vs. specific oil change). Output a JSON object with key \"intent\" set to the single most accurate finalist option.",
    "questions": [
      {
        "id": "intent",
        "type": "choice",
        "instructions": "Select the exact best-matching finalist intent.",
        "options": [
          {{- if .options }}
          {{ range $i, $opt := .options }}
          {{ if $i }},{{ end }}{"name": {{ $opt | toJson }}}
          {{ end }}
          {{- else }}
          {"name": "lost_or_stolen_card"},
          {"name": "compromised_card"}
          {{- end }}
        ]
      }
    ],
    "samples": 1
  },
  "state": {
    "utterance": {{ default "Someone used my card number online even though my card is still in my wallet." .text | toJson }},
    "first_pass_guess": {{ default "lost_or_stolen_card" .first_guess | toJson }},
    "candidate_finalists": {{ if .options }}{{ .options | toJson }}{{ else }}["lost_or_stolen_card", "compromised_card"]{{ end }}
  }
}
