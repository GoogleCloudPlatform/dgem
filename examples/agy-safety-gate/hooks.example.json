{
  "dgem-safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 examples/agy-safety-gate/dgem_gate.py hook",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
