  <script is:inline src="/dgem/landing/journey.js"></script>
  <script is:inline>
    document.getElementById('theme-toggle')?.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      localStorage.setItem('theme', next);
      localStorage.setItem('starlight-theme', next);
    });

    document.querySelectorAll('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-copy') || '';
        try {
          await navigator.clipboard.writeText(text);
          btn.classList.add('copied');
          setTimeout(() => btn.classList.remove('copied'), 1400);
        } catch {}
      });
    });

    const CASES = {
      triage: {
        title: "1. Support & Incident Triage (Multi-Slot Choice + Sentiment Rubric)",
        uri: "./bin/dgem decide -t templates/support_triage.json.tmpl -v 'ticket=Charged twice on invoice #9481 and prod API locked!' --stats",
        summary: "Unmasks department, priority, sentiment (score), and escalation slots simultaneously in a single forward pass (~135-265 ms warm GPU). Returns per-option probabilities, expected score, and pre-fusion raw_normalized_entropy.",
        metrics: [["~155 ms", "Warm GPU Pass (135-265 ms)"], ["0.062", "Pre-Fusion H_raw (Clear)"], ["0.942", "Top Option P(billing) (illustrative)"], ["4 Slots", "Unmasked in 1 Pass (≤8 max)"]],
        steps: [
          ["1. Render .json.tmpl Policy", "templates/support_triage.json.tmpl", "Injects .ticket state into schema.questions (choice + score levels)"],
          ["2. Single-Step Slot Denoise", "O(1) Diffusion Pass", "Unmasks department, priority, sentiment, and escalate slots at once"],
          ["3. Pre-Fusion Hesitation Gate", "raw_normalized_entropy < 0.16", "Classified as CLEAR (<16% hesitation); skips Stage 2 Gemini escalation"],
          ["4. Structured JSON Response", "X-DGem-Backend-Used: vertex", "Returns chosen option, probability vector, raw_normalized_entropy, and trace ID"]
        ]
      },
      agentdrift: {
        title: "2. AgentDrift & Tool-Call Security Guardrail",
        uri: "./bin/dgem decide -t templates/calibration/agent_step_drift.json.tmpl -v 'task=Check loan fees' -v 'step=Add external beneficiary' --stats",
        summary: "Audits autonomous agent tool calls before execution for trajectory drift, prompt injection, and unauthorized parameter mutation in a single pass.",
        metrics: [["~145 ms", "Warm GPU Guardrail Pass"], ["0.16", "H_raw Escalation Threshold"], ["84% Fast", "Clear Fast-Path Rate (illustrative)"], ["95% Acc", "Cascade Accuracy (illustrative)"]],
        steps: [
          ["1. Intercept Tool Call", "Pre-Execution Hook", "Captures user task intent and proposed tool call arguments in state"],
          ["2. Stage 1 Single-Pass Audit", "templates/calibration/agent_step_drift.json.tmpl", "Scores trajectory alignment and risk rubric in one forward step"],
          ["3. Pre-Fusion Hesitation Check", "raw_normalized_entropy = H / ln(K)", "Clear safe/hijack calls return immediately; hesitant calls escalate"],
          ["4. Enforce Policy Gate", "BLOCK / ALLOW / ESCALATE", "Blocks unauthorized beneficiary injection before tool execution"]
        ]
      },
      rerank: {
        title: "3. Listwise RAG Passage Reranking & Grounding Verification",
        uri: "./bin/dgem decide -t templates/rerank/listwise_decision_rerank.json.tmpl -f query_and_chunks.json --stats",
        summary: "Scores candidate retrieval passages on an ordinal relevance scale plus answerability/grounding gates in a single forward pass (up to MaxSlotsPerPass = 8) using Continuous Softmax Expectation.",
        metrics: [["≤ 8 Slots", "MaxSlotsPerPass in 1 Pass"], ["E[r] = ∑ g·p_g", "Continuous Tie-Breaking"], ["~165 ms", "Warm GPU Listwise Pass"], ["1 Pass", "No Autoregressive Loops"]],
        steps: [
          ["1. Pack Candidate Chunks", "templates/rerank/listwise_decision_rerank.json.tmpl", "Places query + candidate passages into a single structured prompt layout"],
          ["2. Simultaneous Slot Readout", "Up to 8 Score & Choice Slots", "Extracts full ordinal probability distribution p_(i,g) for every candidate"],
          ["3. Softmax Expectation Ranking", "r_i = sum_(g) g * p_(i,g)", "Produces fine-grained continuous relevance scores for tie-breaking"],
          ["4. Pre-Fusion Hesitation Gate", "raw_normalized_entropy < 0.16", "Escalates to Stage 2 only when top candidate relevance is hesitant"]
        ]
      },
      tournament: {
        title: "4. Wide-Option Routing (K > 26 Options via Brackets or Shortlist)",
        uri: "./bin/dgem decide -t policy_wide.json.tmpl --bracket-size 20 --shortlist-topk 15 --prior-gate-mode hesitant",
        summary: "Handles option sets larger than 26 single-letter tokens ([A-Z]) using two-stage bracket tournaments (--bracket-size 20), embedding/lexical shortlisting (decisionindex.PriorLogitsShortlist), or extended labels (--labels az_aa / az_lower up to 52).",
        metrics: [["K > 26", "Wide Option Catalogs"], ["--bracket-size 20", "Default Two-Stage Tournament"], ["--shortlist-topk", "PriorLogits / Lexical Shortlist"], ["Up to 52", "--labels az_aa / az_lower"]],
        steps: [
          ["1. Select Wide-K Strategy", "--bracket-size 20 or --shortlist-topk", "Use PriorLogitsShortlist (dense cosine) when embeddings exist, or brackets"],
          ["2. Pre-Pass / Round-1 Scoring", "pkg/decisionindex", "Prunes wide option list down to top contenders fitting a single pass"],
          ["3. Hesitation-Gated Prior Fusion", "decisionindex.FusePriorWithGateMode", "Applies NormalizeCosinePriorLogits with --prior-gate-mode hesitant"],
          ["4. Pre-Fusion Cascade Gate", "raw_normalized_entropy < 0.16", "Gates Stage 2 strictly on pre-fusion hesitation to preserve AUROC"]
        ]
      },
      secops: {
        title: "5. SecOps Conditional DAG & GitHub Spam Triage",
        uri: "./bin/dgem decide -t templates/secops_conditional_dag.json.tmpl --prior-weight 0.5 --prior-gate-mode hesitant --stats",
        summary: "Evaluates multi-slot security operations alert triage (templates/secops_conditional_dag.json.tmpl) and high-throughput abuse screening (templates/github_spam_triage.json.tmpl) in one pass.",
        metrics: [["≤ 8 Slots", "Conditional DAG in 1 Pass"], ["Hesitant Gate", "FusePriorWithGateMode"], ["~140 ms", "Warm GPU Readout"], ["0.16 Gate", "Selective Gemini Verify"]],
        steps: [
          ["1. Structured Alert State", "templates/secops_conditional_dag.json.tmpl", "Binds alert telemetry or issue payload into multi-slot policy schema"],
          ["2. Simultaneous DAG Readout", "Severity + Action + Escalation", "Unmasks root classification and conditional follow-up slots in 1 pass"],
          ["3. Hesitation-Gated Prior", "--prior-gate-mode hesitant", "Fuses historical base rates only when Stage 1 is hesitant (H_raw > 0.05)"],
          ["4. Stage 2 Escalation", "raw_normalized_entropy >= 0.16", "Routes high-entropy alerts to gemini-3.8-flash for deep inspection"]
        ]
      },
      locate: {
        title: "6. Guided Object Localization (dgem locate) & Categorical Image QA",
        uri: "./bin/dgem locate -u '<ENDPOINT>/v1' --gcp-auth -I photo.jpg --find 'espresso machine' --skip-h 0.16",
        summary: "Uses Stage 1 dgem for fast categorical presence + 3×3 coarse grid gating (--skip-h 0.16), invoking Stage 2 gemini-3.8-flash for precise bounding boxes only when the object is present (plus optional Stage 3 SAM segmentation).",
        metrics: [["Stage 1 Gate", "Presence + 3×3 Grid Cell"], ["--skip-h 0.16", "Skips Stage 2 When Absent"], ["Stage 2 Box", "gemini-3.8-flash BBox"], ["Stage 3 Mask", "Optional SAM Segmentation"]],
        steps: [
          ["1. Stage 1 Presence & 3×3 Grid", "dgem locate / vision_aspects.json.tmpl", "Checks if target is present and identifies coarse 3×3 spatial zone in 1 pass"],
          ["2. Fast-Skip Absent Images", "--skip-h 0.16 Gate", "Skips Stage 2 VLM call entirely when Stage 1 confidently reports absent"],
          ["3. Stage 2 Precise BBox", "gemini-3.8-flash", "Computes exact [ymin, xmin, ymax, xmax] coordinates on confirmed images"],
          ["4. Contact Sheet Verification", "contact_sheet_verify.json.tmpl", "Optionally audits multi-crop contact sheets or runs Stage 3 SAM masks"]
        ]
      }
    };

    function renderExplorer(key) {
      const d = CASES[key];
      const panel = document.getElementById('dgem-exp-panel');
      if (!d || !panel) return;
      panel.innerHTML = `
        <div>
          <h3 style="margin:0 0 0.45rem 0;font-size:1.15rem;">${d.title}</h3>
          <div class="dgem-uri-box"><code>${d.uri}</code></div>
          <p style="margin:0 0 0.9rem 0;font-size:0.92rem;line-height:1.55;opacity:0.9;">${d.summary}</p>
          <div class="dgem-metric-grid">
            ${d.metrics.map(m => `<div class="dgem-metric-card"><div class="dgem-metric-val">${m[0]}</div><div class="dgem-metric-lbl">${m[1]}</div></div>`).join('')}
          </div>
        </div>
        <div>
          <ol class="dgem-stage-list">
            ${d.steps.map((s) => `
              <li class="dgem-stage-item">
                <div class="dgem-stage-hdr">
                  <strong style="color:var(--fg)">${s[0]}</strong>
                  <span style="color:var(--accent);font-weight:600">${s[1]}</span>
                </div>
                <div style="color:var(--fg-muted);font-size:0.8rem">${s[2]}</div>
              </li>
            `).join('')}
          </ol>
        </div>
      `;
    }

    document.querySelectorAll('.dgem-exp-tab').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.dgem-exp-tab').forEach(b => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        renderExplorer(btn.getAttribute('data-case'));
      });
    });
    renderExplorer('triage');
  </script>
</body>
