    <!-- PARADIGM SHIFT: AUTOREGRESSIVE LOOP VS DGEM 1-PASS DIFFUSION -->
    <section class="sec" id="paradigm" data-race>
      <div class="sec-head-row">
        <div class="sec-head">
          <span class="sec-eyebrow">Why Discrete Diffusion for Decisions</span>
          <h2>Stop decoding JSON punctuation one token at a time.</h2>
          <p>Autoregressive models spend sequential forward passes emitting braces, quotes, and field names with uncalibrated verbalized confidence. <strong>dgem</strong> places masked decision slots directly in the prompt and unmasks all of them in a single forward pass.</p>
        </div>
        <button type="button" class="btn-ghost" id="race-replay-btn" data-race-replay>↻ Replay Comparison</button>
      </div>

      <div class="race-grid">
        <div class="race-card">
          <div class="race-hdr">
            <h3>Autoregressive JSON Decoding</h3>
            <span class="race-chip">O(T) Sequential Steps</span>
          </div>
          <div class="race-stream">
            <div class="ar-tokens"><span data-ar-stream></span><span class="ar-cursor" aria-hidden="true"></span></div>
          </div>
          <div class="race-foot">
            <span>Token-by-token latency scales with output length</span>
            <span>Verbalized confidence is poorly calibrated</span>
          </div>
        </div>

        <div class="race-card race-card--dgem">
          <div class="race-hdr">
            <h3>dgem Single-Pass Slot Denoise</h3>
            <span class="race-chip race-chip--fast">O(1) Step · ~135–265 ms Warm GPU</span>
          </div>
          <div class="race-stream">
            <div class="dgem-parallel-pills">
              <span class="dp-pill is-unmasked" data-dp-pill data-mask="department: [MASK]" data-final="department = billing (0.94)">department = billing (0.94)</span>
              <span class="dp-pill is-unmasked" data-dp-pill data-mask="priority: [MASK]" data-final="priority = p1 (0.92)">priority = p1 (0.92)</span>
              <span class="dp-pill is-unmasked" data-dp-pill data-mask="sentiment: [MASK]" data-final="sentiment = 2.34 / 3">sentiment = 2.34 / 3</span>
              <span class="dp-pill is-unmasked" data-dp-pill data-mask="escalate: [MASK]" data-final="escalate = true (0.90)">escalate = true (0.90)</span>
            </div>
          </div>
          <div class="race-foot">
            <span>Up to 8 slots unmasked simultaneously</span>
            <span>Exact softmax probabilities + H_raw ∈ [0, 1]</span>
          </div>
        </div>
      </div>
    </section>

