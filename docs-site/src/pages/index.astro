<span class="hl-line is-lit">        <span class="k">"options"</span>: [&#123;<span class="k">"name"</span>: <span class="s">"billing"</span>&#125;, &#123;<span class="k">"name"</span>: <span class="s">"technical"</span>&#125;, &#123;<span class="k">"name"</span>: <span class="s">"account"</span>&#125;] &#125;,</span>
<span class="hl-line">      &#123; <span class="k">"id"</span>: <span class="s">"sentiment"</span>, <span class="k">"type"</span>: <span class="s">"score"</span>, <span class="k">"levels"</span>: [<span class="s">"calm"</span>, <span class="s">"frustrated"</span>, <span class="s">"furious"</span>] &#125;</span>
<span class="hl-line">    ],</span>
<span class="hl-line">    <span class="k">"samples"</span>: &#123;&#123; default <span class="n">1</span> .samples | toJson &#125;&#125;</span>
<span class="hl-line">  &#125;,</span>
<span class="hl-line">  <span class="k">"state"</span>: &#123; <span class="k">"ticket"</span>: &#123;&#123; default <span class="s">"No ticket text"</span> .ticket | toJson &#125;&#125; &#125;</span>
<span class="hl-line">&#125;</span></code></pre>
            </div>
